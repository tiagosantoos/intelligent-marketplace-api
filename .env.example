# Configuração local opcional. Copie para .env e ajuste os valores.
APP_NAME="Intelligent Marketplace API"
APP_ENV=development
DOCS_ENABLED=true

# Vazio: a API inicia sem banco e /health/ready retorna 503.
# Exemplo SOMENTE para o PostgreSQL local do compose.yaml:
# DATABASE_URL=postgresql+psycopg://marketplace:marketplace@localhost:5432/marketplace
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=5
ANALYTICS_QUERY_TIMEOUT_SECONDS=5

# Configure ambos para habilitar o Executivo. Nunca publique a chave real.
OPENAI_API_KEY=
# Identificador de um modelo com ferramentas disponível em sua conta OpenAI.
OPENAI_MODEL=
AGENT_TIMEOUT_SECONDS=60
